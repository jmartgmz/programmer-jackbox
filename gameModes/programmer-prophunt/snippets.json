            "#include <iostream>",
            "#include <string>",
            "#include <vector>",
            "",
            "// Turn a title into a simple slug-like key used for logs.",
            "std::string to_key(const std::string& title) {",
            "\tstd::string result;",
            "\tfor (char ch : title) {",
            "\t\tif (ch == ' ') {",
            "\t\t\tresult.push_back('_');",
            "\t\t} else if (ch >= 'A' && ch <= 'Z') {",
            "\t\t\tresult.push_back(static_cast<char>(ch - 'A' + 'a'));",
            "\t\t} else {",
            "\t\t\tresult.push_back(ch);",
            "\t\t}",
            "\t}",
            "\treturn result;",
            "}",
            "",
            "// Return the average of non-negative numbers only.",
            "double average_non_negative(const std::vector<int>& values) {",
            "\tint count = 0;",
            "\tint sum = 0;",
            "",
            "\tfor (int value : values) {",
            "\t\tif (value >= 0) {",
            "\t\t\tsum += value;",
            "\t\t\tcount += 1;",
            "\t\t}",
            "\t}",
            "",
            "\treturn count == 0 ? 0.0 : static_cast<double>(sum) / count;",
            "}",
            "",
            "int main() {",
            "\tstd::vector<int> values = {5, -1, 7, 12, -3};",
            "\tstd::cout << \"Key: \" << to_key(\"Daily Report\") << \"\\n\";",
            "\tstd::cout << \"Average: \" << average_non_negative(values) << \"\\n\";",
            "\treturn 0;",
            "}"
