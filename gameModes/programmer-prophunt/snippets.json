            "function buildReport(rows) {",
            "  const grouped = {};",
            "  for (const row of rows) {",
            "    grouped[row.type] = (grouped[row.type] || 0) + row.value;",
            "  }",
            "  return Object.entries(grouped).sort((a, b) => b[1] - a[1]);",
