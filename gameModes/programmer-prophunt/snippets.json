            "// Normalize display names for consistent UI labels.",
            "function normalizeName(input) {",
            "\tif (!input) {",
            "\t\treturn \"guest\";",
            "\t}",
            "\treturn String(input).trim().toLowerCase();",
            "}",
            "",
            "// Add points while protecting against negative values.",
            "function addPoints(currentScore, delta) {",
            "\tconst safeCurrent = Math.max(0, Number(currentScore) || 0);",
            "\tconst safeDelta = Number(delta) || 0;",
            "\treturn Math.max(0, safeCurrent + safeDelta);",
            "}",
            "",
            "function summarizeRound(teamName, scoreBefore, pointsEarned) {",
            "\tconst scoreAfter = addPoints(scoreBefore, pointsEarned);",
            "\treturn `${teamName} moved from ${scoreBefore} to ${scoreAfter}.`;",
            "}",
            "",
