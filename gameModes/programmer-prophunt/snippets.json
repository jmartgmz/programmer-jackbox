            "\tint total = 0;",
            "\tfor (int i = 0; i < length; i++) {",
            "\t\tif (scores[i] >= pass_mark) {",
            "\t\t\ttotal++;",
            "\t\t}",
            "\t}",
            "\treturn total;",
