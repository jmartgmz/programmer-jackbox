            "\t\tint sum = 0;",
            "\t\tint count = 0;",
            "",
            "\t\tforeach (var value in values)",
            "\t\t{",
            "\t\t\tif (value >= 0)",
            "\t\t\t{",
            "\t\t\t\tsum += value;",
            "\t\t\t\tcount++;",
            "\t\t\t}",
            "\t\t}",
            "",
            "\t\treturn count == 0 ? 0.0 : (double)sum / count;",
