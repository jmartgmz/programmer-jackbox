        [
            "function tokenize(source) {",
            "  const tokens = [];",
            "  let current = \"\";",
            "",
            "  for (const ch of source) {",
            "    if (/\\s/.test(ch)) {",
            "      if (current) tokens.push(current);",
            "      current = \"\";",
            "      continue;",
            "    }",
            "    current += ch;",
            "  }",
            "",
            "  if (current) tokens.push(current);",
            "  return tokens;",
            "}"
        ]
