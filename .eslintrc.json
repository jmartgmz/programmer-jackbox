{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": ["eslint:recommended", "plugin:prettier/recommended"],
    "parserOptions": {
        "ecmaVersion": 12,
        "sourceType": "module"
    },
    "globals": {
        "io": "readonly"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-undef": "warn",
        "prettier/prettier": "warn"
    }
}
